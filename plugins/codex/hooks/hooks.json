{
  "description": "Optional stop-time review gate for Codex Companion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/with-bun.sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.ts", "SessionStart"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/with-bun.sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.ts", "SessionEnd"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/with-bun.sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/stop-review-gate-hook.ts"],
            "timeout": 900
          }
        ]
      }
    ]
  }
}
